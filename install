#!/usr/bin/env bash
set -euo pipefail
APP=maebrcode

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
PURPLE='\033[38;2;180;140;255m'
NC='\033[0m' # No Color

requested_version=${VERSION:-}

os=$(uname -s | tr '[:upper:]' '[:lower:]')
if [[ "$os" == "darwin" ]]; then
    os="mac"
fi
arch=$(uname -m)

if [[ "$arch" == "aarch64" ]]; then
  arch="arm64"
fi

filename="$APP-$os-$arch.tar.gz"


case "$filename" in
    *"-linux-"*)
        [[ "$arch" == "x86_64" || "$arch" == "arm64" || "$arch" == "i386" ]] || exit 1
    ;;
    *"-mac-"*)
        [[ "$arch" == "x86_64" || "$arch" == "arm64" ]] || exit 1
    ;;
    *)
        echo "${RED}Unsupported OS/Arch: $os/$arch${NC}"
        exit 1
    ;;
esac

INSTALL_DIR=$HOME/.maebrcode/bin
mkdir -p "$INSTALL_DIR"

if [ -z "$requested_version" ]; then
    url="https://github.com/mohammadtihame/maebrcode/releases/latest/download/$filename"
    specific_version=$(curl -s https://api.github.com/repos/mohammadtihame/maebrcode/releases/latest | awk -F'"' '/"tag_name": "/ {gsub(/^v/, "", $4); print $4}')

    if [[ $? -ne 0 ]]; then
        echo "${RED}Failed to fetch version information${NC}"
        exit 1
    fi
else
    url="https://github.com/mohammadtihame/maebrcode/releases/download/v${requested_version}/$filename"
    specific_version=$requested_version
fi

print_message() {
    local level=$1
    local message=$2
    local color=""

    case $level in
        info) color="${GREEN}" ;;
        warning) color="${YELLOW}" ;;
        error) color="${RED}" ;;
    esac

    echo -e "${color}${message}${NC}"
}

check_version() {
    if command -v maebrcode >/dev/null 2>&1; then
        maebrcode_path=$(which maebrcode)


        ## TODO: check if version is installed
        # installed_version=$(maebrcode version)
        installed_version="0.0.1"
        installed_version=$(echo $installed_version | awk '{print $2}')

        if [[ "$installed_version" != "$specific_version" ]]; then
            print_message info "Installed version: ${YELLOW}$installed_version."
        else
            print_message info "Version ${YELLOW}$specific_version${GREEN} already installed"
            exit 0
        fi
    fi
}

download_and_install() {
    print_message info "Downloading ${PURPLE}maebrcode ${GREEN}version: ${YELLOW}$specific_version ${GREEN}..."
    mkdir -p maebrcodetmp && cd maebrcodetmp
    curl -# -L $url | tar xz
    mv maebrcode $INSTALL_DIR
    cd .. && rm -rf maebrcodetmp 
}

check_version
download_and_install

configure_ai_provider() {
    if [[ ! -t 0 ]]; then
        return
    fi

    printf "\n"
    read -r -p "Configure an AI provider now? [Y/n] " configure_now
    configure_now=${configure_now:-Y}
    if [[ ! "$configure_now" =~ ^[Yy]$ ]]; then
        return
    fi

    echo "Select provider:"
    echo "  1) OpenAI"
    echo "  2) Anthropic"
    echo "  3) Google Gemini"
    echo "  4) OpenRouter"
    echo "  5) xAI"
    echo "  6) Azure OpenAI"
    echo "  7) Ollama local"
    echo "  8) Custom OpenAI-compatible API"
    echo "  9) Skip"
    read -r -p "Provider [1]: " provider_choice
    provider_choice=${provider_choice:-1}

    provider_id=""
    provider_type=""
    base_url=""
    default_model=""
    needs_key=1

    case "$provider_choice" in
        1) provider_id="openai"; provider_type="openai"; default_model="gpt-4.1" ;;
        2) provider_id="anthropic"; provider_type="anthropic"; default_model="claude-sonnet-4-20250514" ;;
        3) provider_id="gemini"; provider_type="gemini"; default_model="gemini-2.5-pro" ;;
        4) provider_id="openrouter"; provider_type="openrouter"; default_model="anthropic/claude-3.7-sonnet" ;;
        5) provider_id="xai"; provider_type="xai"; default_model="grok-3-beta" ;;
        6) provider_id="azure"; provider_type="azure"; default_model="gpt-4.1" ;;
        7)
            provider_id="ollama"; provider_type="ollama"; base_url="${OLLAMA_ENDPOINT:-${OLLAMA_HOST:-http://localhost:11434}}"; default_model="llama3.2"; needs_key=0
            base_url="${base_url%/}"
            if [[ "$base_url" != */v1 ]]; then
                base_url="$base_url/v1"
            fi
            ;;
        8)
            read -r -p "Provider id (example: together, fireworks, perplexity): " provider_id
            provider_id=${provider_id:-custom}
            provider_type="openai-compatible"
            read -r -p "Base URL (example: https://api.example.com/v1): " base_url
            ;;
        9) return ;;
        *) print_message warning "Skipping provider configuration"; return ;;
    esac

    api_key=""
    if [[ "$needs_key" -eq 1 ]]; then
        read -r -s -p "API key: " api_key
        printf "\n"
    else
        api_key="ollama"
        read -r -p "Ollama base URL [$base_url]: " entered_base_url
        base_url=${entered_base_url:-$base_url}
    fi

    read -r -p "Model name [$default_model]: " model_name
    model_name=${model_name:-$default_model}

    if [[ -z "$provider_id" || -z "$provider_type" || -z "$model_name" ]]; then
        print_message warning "Provider configuration skipped; provider and model are required."
        return
    fi
    if [[ "$provider_type" == "openai-compatible" && -z "$base_url" ]]; then
        print_message warning "Provider configuration skipped; custom OpenAI-compatible providers require a base URL."
        return
    fi

    config_file="$HOME/.maebrcode.json"
    if ! command -v python3 >/dev/null 2>&1; then
        print_message warning "python3 not found; manually add provider configuration to $config_file"
        return
    fi

    PROVIDER_ID="$provider_id" \
    PROVIDER_TYPE="$provider_type" \
    PROVIDER_API_KEY="$api_key" \
    PROVIDER_BASE_URL="$base_url" \
    PROVIDER_MODEL="$model_name" \
    CONFIG_FILE="$config_file" \
    python3 <<'PY'
import json
import os
from pathlib import Path

path = Path(os.environ["CONFIG_FILE"]).expanduser()
if path.exists():
    try:
        config = json.loads(path.read_text())
    except json.JSONDecodeError:
        config = {}
else:
    config = {}

provider_id = os.environ["PROVIDER_ID"]
provider_type = os.environ["PROVIDER_TYPE"]
api_key = os.environ["PROVIDER_API_KEY"]
base_url = os.environ["PROVIDER_BASE_URL"]
model = os.environ["PROVIDER_MODEL"]

providers = config.setdefault("providers", {})
provider_cfg = providers.setdefault(provider_id, {})
provider_cfg["type"] = provider_type
provider_cfg["apiKey"] = api_key
provider_cfg["disabled"] = False
if base_url:
    provider_cfg["baseURL"] = base_url
elif "baseURL" in provider_cfg:
    provider_cfg.pop("baseURL")

agents = config.setdefault("agents", {})
for name in ("coder", "summarizer", "task", "title"):
    agent = agents.setdefault(name, {})
    agent["provider"] = provider_id
    agent["model"] = model
    agent["maxTokens"] = 80 if name == "title" else int(agent.get("maxTokens") or 5000)

path.write_text(json.dumps(config, indent=2) + "\n")
PY
    print_message info "Configured ${PURPLE}${provider_id}${GREEN} with model ${YELLOW}${model_name}${GREEN} in $config_file"
}

configure_ai_provider


add_to_path() {
    local config_file=$1
    local command=$2

    if [[ -w $config_file ]]; then
        echo -e "\n# maebrcode" >> "$config_file"
        echo "$command" >> "$config_file"
        print_message info "Successfully added ${PURPLE}maebrcode ${GREEN}to \$PATH in $config_file"
    else
        print_message warning "Manually add the directory to $config_file (or similar):"
        print_message info "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

current_shell=$(basename "$SHELL")
case $current_shell in
    fish)
        config_files="$HOME/.config/fish/config.fish"
    ;;
    zsh)
        config_files="$HOME/.zshrc $HOME/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
    ;;
    bash)
        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
    ash)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    sh)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    *)
        # Default case if none of the above matches
        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
esac

config_file=""
for file in $config_files; do
    if [[ -f $file ]]; then
        config_file=$file
        break
    fi
done

if [[ -z $config_file ]]; then
    print_message error "No config file found for $current_shell. Checked files: ${config_files[@]}"
    exit 1
fi

if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
    case $current_shell in
        fish)
            add_to_path "$config_file" "fish_add_path $INSTALL_DIR"
        ;;
        zsh)
            add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
        ;;
        bash)
            add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
        ;;
        ash)
            add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
        ;;
        sh)
            add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
        ;;
        *)
            print_message warning "Manually add the directory to $config_file (or similar):"
            print_message info "  export PATH=$INSTALL_DIR:\$PATH"
        ;;
    esac
fi

if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" == "true" ]; then
    echo "$INSTALL_DIR" >> $GITHUB_PATH
    print_message info "Added $INSTALL_DIR to \$GITHUB_PATH"
fi
